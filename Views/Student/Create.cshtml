@model LibraryManagement.Models.Student

@{
    ViewData["Title"] = "Add Student";
    ViewData["HeaderDescription"] = "Register a new student account.";
    ViewData["HeaderIcon"] = "bi-person-plus";
    ViewData["BreadcrumbParent"] = "Students";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Students</a></li>
                <li class="breadcrumb-item active">Add Student</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Add New Student</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Student Profile Information</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="StudentName" class="form-label">Full Name</label>
                        <input asp-for="StudentName" class="form-control" placeholder="Enter student's full name" required />
                        <span asp-validation-for="StudentName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="e.g. student@university.edu" required />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. +1 (555) 000-0000" required />
                        <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Add Student
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}