<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div id="app-wrapper">
        <!-- Sidebar Navigation -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div id="sidebar-overlay"></div>
            <aside id="sidebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i>
                    <span>Library Admin</span>
                </a>

                <div class="sidebar-nav">
                    <div class="sidebar-header">Main Navigation</div>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="sidebar-header">Book Catalog</div>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "active" : "")"
                       asp-controller="Books" asp-action="Index">
                        <i class="bi bi-bookshelf"></i>
                        <span>Manage Books</span>
                    </a>

                    <div class="sidebar-header">User Management</div>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" ? "active" : "")"
                       asp-controller="Student" asp-action="Index">
                        <i class="bi bi-mortarboard"></i>
                        <span>Students</span>
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Librarian" ? "active" : "")"
                       asp-controller="Librarian" asp-action="Index">
                        <i class="bi bi-person-badge"></i>
                        <span>Librarians</span>
                    </a>

                    <div class="sidebar-header">Periodicals & Extras</div>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Publications" && ViewContext.RouteData.Values["type"]?.ToString() == "Newspaper" ? "active" : "")"
                       asp-controller="Publications" asp-action="Index" asp-route-type="Newspaper">
                        <i class="bi bi-newspaper"></i>
                        <span>Newspapers</span>
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Publications" && ViewContext.RouteData.Values["type"]?.ToString() == "Magazine" ? "active" : "")"
                       asp-controller="Publications" asp-action="Index" asp-route-type="Magazine">
                        <i class="bi bi-journal-bookmark"></i>
                        <span>Magazines</span>
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
                       asp-controller="Products" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        <span>Products</span>
                    </a>
                </div>

                <div class="p-3 border-top border-secondary border-opacity-25 mt-auto">
                    <div class="d-flex align-items-center gap-2 text-white-50 small">
                        <i class="bi bi-shield-check text-success"></i>
                        <span>Administrator Active</span>
                    </div>
                </div>
            </aside>
        }

        <!-- Main Content Area -->
        <div id="content-wrapper">
            <!-- Topbar Header -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button id="sidebarToggle" class="topbar-toggle d-lg-none" aria-label="Toggle menu">
                            <i class="bi bi-list fs-4"></i>
                        </button>
                    }
                    <div class="text-secondary small d-none d-sm-block">
                        <i class="bi bi-calendar3 me-1"></i>
                        @DateTime.Now.ToString("ddd, MMM dd, yyyy")
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <!-- Quick Add Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-primary dropdown-toggle" type="button" id="quickAddMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-plus-circle me-1"></i> Quick Add
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="quickAddMenu">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Books" asp-action="Create">
                                        <i class="bi bi-book me-2 text-primary"></i>Add Book
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Student" asp-action="Create">
                                        <i class="bi bi-person-plus me-2 text-success"></i>Add Student
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Librarian" asp-action="Create">
                                        <i class="bi bi-person-badge me-2 text-info"></i>Add Librarian
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Publications" asp-action="Create" asp-route-type="Newspaper">
                                        <i class="bi bi-newspaper me-2 text-warning"></i>Add Newspaper
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Publications" asp-action="Create" asp-route-type="Magazine">
                                        <i class="bi bi-journal-bookmark me-2 text-danger"></i>Add Magazine
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- User Menu -->
                        <div class="dropdown">
                            <div class="topbar-user" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="d-none d-md-block text-start">
                                    <div class="fw-semibold text-dark fs-6" style="line-height: 1.2;">@User.Identity.Name</div>
                                    <small class="text-secondary" style="font-size: 0.75rem;">Administrator</small>
                                </div>
                                <i class="bi bi-chevron-down text-muted small ms-1"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-grid me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </header>

            <!-- Main Page View Content -->
            <main class="container-fluid p-4 flex-grow-1 fade-in">
                @RenderBody()
            </main>

            <!-- App Footer -->
            <footer class="app-footer mt-auto">
                <div class="container-fluid d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
                    <div>
                        &copy; @DateTime.Now.Year <strong>Library Management System</strong>. All rights reserved.
                    </div>
                    <div>
                        <span class="badge bg-light text-secondary border">v2.0 Professional Edition</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>