@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state py-5 my-3">
    <div class="empty-state-icon bg-danger bg-opacity-10 text-danger mb-3" style="width:72px; height:72px; font-size:2.25rem;">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 class="h3 fw-bold text-dark mb-2">An Error Occurred</h1>
    <p class="empty-state-description text-secondary mb-4">
        An error occurred while processing your request. Please try again or contact your administrator.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="p-3 bg-light border rounded d-inline-block text-start mb-4">
            <span class="text-secondary small d-block mb-1">Diagnostic Context</span>
            <code class="text-dark fs-6">Request ID: @Model.RequestId</code>
        </div>
    }

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-semibold">
            <i class="bi bi-house me-1"></i> Return to Dashboard
        </a>
    </div>
</div>
