@model ProductAdmin.Models.Product

@{
    ViewData["Title"] = "Product Details";
    ViewData["HeaderDescription"] = "Overview of product catalog item.";
    ViewData["HeaderIcon"] = "bi-box-seam";
    ViewData["BreadcrumbParent"] = "Products";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Products</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">@Model.ProductName</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Product
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Product Overview</h2>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.ImagePath" alt="@Model.ProductName" class="rounded border object-fit-cover" style="max-width:240px; max-height:240px;" />
                    </div>
                }

                <div class="row g-3">
                    <div class="col-sm-4 text-secondary">Product ID</div>
                    <div class="col-sm-8 text-dark fw-bold">#@Model.Id</div>

                    <div class="col-sm-4 text-secondary">Product Name</div>
                    <div class="col-sm-8 text-dark fw-semibold">@Model.ProductName</div>

                    <div class="col-sm-4 text-secondary">Category</div>
                    <div class="col-sm-8"><span class="badge bg-light text-dark border">@Model.ProductCategory</span></div>

                    <div class="col-sm-4 text-secondary">Freshness</div>
                    <div class="col-sm-8"><span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@Model.ProductFreshness</span></div>

                    <div class="col-sm-4 text-secondary">Description</div>
                    <div class="col-sm-8 text-dark">@Model.AdditionalDescription</div>

                    <div class="col-sm-4 text-secondary">Product Price</div>
                    <div class="col-sm-8 text-dark fw-bold">$@Model.ProductPrice.ToString("0.00")</div>

                    <div class="col-sm-4 text-secondary">MRP</div>
                    <div class="col-sm-8 text-secondary"><del>$@Model.MRP.ToString("0.00")</del></div>

                    <div class="col-sm-4 text-secondary">Comments</div>
                    <div class="col-sm-8 text-dark">@Model.Comments</div>

                    <div class="col-sm-4 text-secondary">Manager Contact</div>
                    <div class="col-sm-8 text-dark">
                        <div><i class="bi bi-envelope me-1 text-secondary"></i>@Model.ManagerEmail</div>
                        <div><i class="bi bi-telephone me-1 text-secondary"></i>@Model.ManagerPhoneNumber</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>