@model ProductAdmin.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    ViewData["HeaderDescription"] = "Update product specification and details.";
    ViewData["HeaderIcon"] = "bi-pencil-square";
    ViewData["BreadcrumbParent"] = "Products";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Products</a></li>
                <li class="breadcrumb-item active">Edit Product</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Edit Product: @Model.ProductName</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Update Details</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProductName" class="form-label">Product Name</label>
                            <input asp-for="ProductName" class="form-control" required />
                            <span asp-validation-for="ProductName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductCategory" class="form-label">Category</label>
                            <select asp-for="ProductCategory" class="form-select" required>
                                <option value="">Please Select</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Clothing">Clothing</option>
                                <option value="Furniture">Furniture</option>
                                <option value="Books">Books</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="ProductCategory" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">Product Freshness</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input asp-for="ProductFreshness" type="radio" value="Brand New" class="form-check-input" id="freshBrandNew" required />
                                <label class="form-check-label" for="freshBrandNew">Brand New</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="ProductFreshness" type="radio" value="Second Hand" class="form-check-input" id="freshSecondHand" />
                                <label class="form-check-label" for="freshSecondHand">Second Hand</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="ProductFreshness" type="radio" value="Refurbished" class="form-check-input" id="freshRefurbished" />
                                <label class="form-check-label" for="freshRefurbished">Refurbished</label>
                            </div>
                        </div>
                        <span asp-validation-for="ProductFreshness" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Product Image</label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImagePath" width="90" height="90" class="rounded border object-fit-cover" alt="Current Image" />
                            </div>
                        }
                        <input type="file" name="imageFile" accept="image/*" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AdditionalDescription" class="form-label">Additional Description</label>
                        <textarea asp-for="AdditionalDescription" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="AdditionalDescription" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProductPrice" class="form-label">Product Price ($)</label>
                            <input asp-for="ProductPrice" class="form-control" required />
                            <span asp-validation-for="ProductPrice" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MRP" class="form-label">MRP ($)</label>
                            <input asp-for="MRP" class="form-control" required />
                            <span asp-validation-for="MRP" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Comments" class="form-label">Manager Comments</label>
                        <textarea asp-for="Comments" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Comments" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ManagerEmail" class="form-label">Manager Email</label>
                            <input asp-for="ManagerEmail" type="email" class="form-control" required />
                            <span asp-validation-for="ManagerEmail" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ManagerPhoneNumber" class="form-label">Manager Phone</label>
                            <input asp-for="ManagerPhoneNumber" class="form-control" required />
                            <span asp-validation-for="ManagerPhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}