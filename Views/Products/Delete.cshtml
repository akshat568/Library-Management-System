@model ProductAdmin.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    ViewData["HeaderDescription"] = "Confirmation screen for deleting product item.";
    ViewData["HeaderIcon"] = "bi-trash";
    ViewData["BreadcrumbParent"] = "Products";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Products</a></li>
                <li class="breadcrumb-item active">Delete</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Confirm Product Deletion</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger border-opacity-25">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Delete Product Record</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong class="d-block">Are you sure you want to delete this product?</strong>
                        <span class="small">This action will remove <strong>@Model.ProductName</strong> permanently from catalog.</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="text-center mb-3">
                        <img src="@Model.ImagePath" alt="@Model.ProductName" width="120" height="120" class="rounded border object-fit-cover" />
                    </div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-sm-4 text-secondary">Product ID</div>
                    <div class="col-sm-8 text-dark fw-bold">#@Model.Id</div>

                    <div class="col-sm-4 text-secondary">Product Name</div>
                    <div class="col-sm-8 text-dark fw-semibold">@Model.ProductName</div>

                    <div class="col-sm-4 text-secondary">Category</div>
                    <div class="col-sm-8"><span class="badge bg-light text-dark border">@Model.ProductCategory</span></div>

                    <div class="col-sm-4 text-secondary">Price</div>
                    <div class="col-sm-8 text-dark fw-bold">$@Model.ProductPrice.ToString("0.00")</div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex align-items-center gap-2 pt-3 border-top">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash me-1"></i> Delete Product
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>