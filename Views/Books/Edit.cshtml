@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Edit Book";
    ViewData["HeaderDescription"] = "Update existing book publication information.";
    ViewData["HeaderIcon"] = "bi-pencil-square";
    ViewData["BreadcrumbParent"] = "Books";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Books</a></li>
                <li class="breadcrumb-item active">Edit Book</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Edit Book: @Model.Title</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Update Details</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.BookId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Book Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Enter book title" required />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Author" class="form-label">Author Name</label>
                        <input asp-for="Author" class="form-control" placeholder="Enter author's name" required />
                        <span asp-validation-for="Author" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label">ISBN Number</label>
                            <input asp-for="ISBN" class="form-control" placeholder="e.g. 978-1234567890" required />
                            <span asp-validation-for="ISBN" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PublishedDate" class="form-label">Published Date</label>
                            <input asp-for="PublishedDate" type="date" class="form-control" required />
                            <span asp-validation-for="PublishedDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}