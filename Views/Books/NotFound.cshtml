@{
    ViewData["Title"] = "Book Not Found";
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="empty-state py-5 my-5">
    <div class="empty-state-icon bg-danger bg-opacity-10 text-danger mb-3" style="width:72px; height:72px; font-size:2.25rem;">
        <i class="bi bi-exclamation-octagon"></i>
    </div>
    <h1 class="h3 fw-bold text-dark mb-2">Book Not Found</h1>
    <p class="empty-state-description text-secondary mb-4">
        @(string.IsNullOrEmpty(errorMessage) ? "The requested book could not be located in our catalog repository." : errorMessage)
    </p>
    <a asp-action="Index" asp-controller="Books" class="btn btn-primary fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Book Catalog
    </a>
</div>