@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Book Details";
    ViewData["HeaderDescription"] = "Comprehensive summary of book catalog details.";
    ViewData["HeaderIcon"] = "bi-book";
    ViewData["BreadcrumbParent"] = "Books";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Books</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">@Model.Title</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Book
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Book Overview</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4 text-secondary fw-medium">Book ID</div>
                    <div class="col-sm-8 text-dark fw-bold">#@Model.BookId</div>

                    <div class="col-sm-4 text-secondary fw-medium">Title</div>
                    <div class="col-sm-8 text-dark">@Model.Title</div>

                    <div class="col-sm-4 text-secondary fw-medium">Author</div>
                    <div class="col-sm-8 text-dark">@Model.Author</div>

                    <div class="col-sm-4 text-secondary fw-medium">ISBN Number</div>
                    <div class="col-sm-8"><code class="text-dark">@Model.ISBN</code></div>

                    <div class="col-sm-4 text-secondary fw-medium">Published Date</div>
                    <div class="col-sm-8 text-dark">@Model.PublishedDate.ToString("yyyy-MM-dd")</div>

                    <div class="col-sm-4 text-secondary fw-medium">Availability Status</div>
                    <div class="col-sm-8">
                        @if (Model.IsAvailable)
                        {
                            <span class="badge-status available">
                                <span class="status-dot"></span> Available
                            </span>
                        }
                        else
                        {
                            <span class="badge-status borrowed">
                                <span class="status-dot"></span> Checked Out
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>