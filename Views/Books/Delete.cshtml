@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Delete Book";
    ViewData["HeaderDescription"] = "Confirmation screen for removing a book from catalog.";
    ViewData["HeaderIcon"] = "bi-trash";
    ViewData["BreadcrumbParent"] = "Books";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Books</a></li>
                <li class="breadcrumb-item active">Delete</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Confirm Deletion</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger border-opacity-25">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Delete Book Confirmation</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong class="d-block">Are you sure you want to delete this book?</strong>
                        <span class="small">This action will permanently remove <strong>@Model.Title</strong> from the library database.</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-4 text-secondary">Title</div>
                    <div class="col-sm-8 text-dark fw-semibold">@Model.Title</div>

                    <div class="col-sm-4 text-secondary">Author</div>
                    <div class="col-sm-8 text-dark">@Model.Author</div>

                    <div class="col-sm-4 text-secondary">ISBN</div>
                    <div class="col-sm-8"><code>@Model.ISBN</code></div>

                    <div class="col-sm-4 text-secondary">Published Date</div>
                    <div class="col-sm-8 text-dark">@Model.PublishedDate.ToString("yyyy-MM-dd")</div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.BookId" method="post" class="d-flex align-items-center gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash me-1"></i> Delete Permanently
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>