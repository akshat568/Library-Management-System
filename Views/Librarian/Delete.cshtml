@model LibraryManagement.Models.Librarian

@{
    ViewData["Title"] = "Delete Librarian";
    ViewData["HeaderDescription"] = "Confirm removal of librarian account.";
    ViewData["HeaderIcon"] = "bi-person-x";
    ViewData["BreadcrumbParent"] = "Librarians";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Librarians</a></li>
                <li class="breadcrumb-item active">Delete</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Confirm Librarian Deletion</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger border-opacity-25">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Delete Staff Record</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong class="d-block">Are you sure you want to delete this librarian account?</strong>
                        <span class="small">This action will remove <strong>@Model.Name</strong> from system staff.</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-4 text-secondary">Librarian ID</div>
                    <div class="col-sm-8 text-dark fw-bold">#@Model.LibrarianId</div>

                    <div class="col-sm-4 text-secondary">Full Name</div>
                    <div class="col-sm-8 text-dark fw-semibold">@Model.Name</div>

                    <div class="col-sm-4 text-secondary">Age</div>
                    <div class="col-sm-8 text-dark">@Model.Age years</div>

                    <div class="col-sm-4 text-secondary">Phone Number</div>
                    <div class="col-sm-8 text-dark">@Model.Phone</div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex align-items-center gap-2 pt-3 border-top">
                    <input type="hidden" asp-for="LibrarianId" />
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash me-1"></i> Delete Librarian
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>