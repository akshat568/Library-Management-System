@model LibraryManagement.Models.Publication

@{
    string currentType = Model.Type.ToString();
    ViewData["Title"] = "Edit " + currentType;
    ViewData["HeaderDescription"] = "Update publication issue details.";
    ViewData["HeaderIcon"] = currentType == "Newspaper" ? "bi-newspaper" : "bi-journal-bookmark";
    ViewData["BreadcrumbParent"] = currentType;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-type="@currentType" class="text-decoration-none">@currentType</a></li>
                <li class="breadcrumb-item active">Edit @currentType</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Edit @currentType: @Model.Title</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 fw-bold mb-0">Update @currentType Details</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Type" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Publication Title</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Publisher" class="form-label">Publisher</label>
                        <input asp-for="Publisher" class="form-control" required />
                        <span asp-validation-for="Publisher" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PublishedDate" class="form-label">Published Date</label>
                            <input asp-for="PublishedDate" type="date" class="form-control" required />
                            <span asp-validation-for="PublishedDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsAvailable" class="form-check-input" />
                        <label asp-for="IsAvailable" class="form-check-label text-dark fw-medium">Available for checkout</label>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" asp-route-type="@currentType" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}