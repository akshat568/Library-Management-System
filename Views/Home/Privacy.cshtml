@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["HeaderDescription"] = "Security and data handling policy for the Library Management System.";
    ViewData["HeaderIcon"] = "bi-shield-check";
}

<partial name="_PageHeader" />

<div class="card">
    <div class="card-body">
        <h2 class="h5 fw-bold mb-3">System Data Protection</h2>
        <p class="text-secondary">
            This application handles library administrative data including catalog items, student enrollment records, staff management details, and borrowing logs in accordance with institution security guidelines.
        </p>
        <hr class="my-4" />
        <h3 class="h6 fw-bold mb-2">Access Control</h3>
        <p class="text-secondary small mb-0">
            Authorized library personnel only. Access logs and actions are audited to maintain system integrity.
        </p>
    </div>
</div>
